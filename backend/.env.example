# Backend env — copy to backend/.env and fill in. NEVER commit backend/.env.
#
# Supabase dashboard → Project Settings → Database → Connection string
# (Session pooler, port 5432). Password = the DB password you set at project creation.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase dashboard → Project Settings → API → Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Derived — just replace the project ref:
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Cloudflare R2: bucket + scoped API token (no public access on the bucket).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=resume-editor-v0

# LLM for tailoring — any OpenAI-compatible chat API. Default is Groq
# (console.groq.com → API Keys); free tier is enough for V0.
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Sentry for backend error reporting. Leave unset to disable.
# SENTRY_DSN=https://...@o...ingest.sentry.io/...

MAX_PARALLEL_COMPILES=4
PORT=8080
